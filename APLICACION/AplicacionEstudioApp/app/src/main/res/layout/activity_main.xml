<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
tools:context=".MainActivity"
    android:id="@+id/main"

    android:background="@drawable/white_gradient"
    >

    <!-- Contenido principal que va detrás del menú -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- Header de la barra superior (Toolbar) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@color/light_blue"
        android:gravity="bottom"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/menu_button"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/iconohamburguesa"
            android:layout_gravity="end" />

        <ImageView
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:src="@drawable/triangulo"
            android:layout_gravity="start" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EI2COREX"
            android:textSize="24sp"
            android:textColor="@color/dark_gray"
            android:padding="16dp"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />
    </androidx.appcompat.widget.Toolbar>


        <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/appbar"
        android:background="@drawable/white_gradient"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Título de la sección "Amistades" -->
            <TextView
                android:id="@+id/amistades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#7651B6"
                android:text="Asignatura"
                android:textAlignment="center"
                android:textColor="#020202"
                android:textSize="20sp"
                android:padding="8dp" />

            <!-- Lista de amigos -->
            <ListView
                android:id="@+id/amistadeslista"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:divider="@android:color/darker_gray"
                android:padding="8dp"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:background="@drawable/border_gradient"/>


        </LinearLayout>
    </FrameLayout>
    </RelativeLayout>
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        app:headerLayout="@layout/header"
        app:menu="@menu/main_menu"
        android:layout_gravity="start"
        android:elevation="10dp" />
</androidx.drawerlayout.widget.DrawerLayout>
