<Window x:Class="Grafica.VentanasSecundarias.Elementos.Calculadora"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculadora Científica" Height="600" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Display -->
        <TextBox x:Name="txtDisplay" FontSize="24" Height="50" IsReadOnly="True" VerticalAlignment="Top" />

        <!-- Botones -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="600px">
            
            <WrapPanel Orientation="Horizontal" Margin="0,0,0,0" Height="600px">


                <!-- Fila 1 -->
            <Button Content="sin" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="cos" Click="Btn_Click"  Height="50px" Width="73px"/>
                <Button Content="tan" Click="Btn_Click"  Height="50px" Width="73px"/>
                <Button Content="ln" Click="Btn_Click"  Height="50px" Width="73px"/>
                <Button Content="log" Click="Btn_Click"  Height="50px" Width="73px"/>
                <Button Content="Ans" Click="Btn_Click" Height="50px" Width="73px"/>

                <!-- Fila 2 -->
                <Button Content="(" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content=")" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="π" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="e" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="^" Click="Btn_Click" Height="50px" Width="73px"/>

            <!-- Fila 3 -->

                <Button Content="/" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="√" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="*" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="!" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="-" Click="Btn_Click" Height="50px" Width="73px"/>
                
                
                <!-- Fila 5 -->
                <Button Content="0" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="1" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="2" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="3" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="4" Click="Btn_Click" Height="50px" Width="73px"/>

                <Button Content="5" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="6" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="7" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="8" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="9" Click="Btn_Click" Height="50px" Width="73px"/>

                <!-- Fila 6 -->
                <Button Content="." Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="C" Click="BtnClear_Click" Height="50px" Width="73px"/>
                <Button Content="=" Click="BtnEqual_Click" Height="50px" Width="73px"/>
                <Button Content="+" Click="Btn_Click" Height="50px" Width="73px"/>

                <Button Content="x" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="y" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="a" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="b" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="c" Click="Btn_Click" Height="50px" Width="73px"/>

            <!-- Fila extra: símbolos matemáticos -->
                <Button Content="∞" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="±" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="≤" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="≥" Click="Btn_Click" Height="50px" Width="73px"/>
                <Button Content="÷" Click="Btn_Click" Height="50px" Width="73px"/>

            <!-- Fila 7 -->
                <Button Content="⌫" Click="BtnBackspace_Click" Height="50px" Width="73px"/>
                <Button Content="Aceptar" Grid.ColumnSpan="4" Click="BtnAceptar_Click" Height="50px" Width="73px"/>
        </WrapPanel>
        </ScrollViewer>

    </Grid>
</Window>
