<Window x:Class="Grafica.VentanasSecundarias.Elementos.Calculadora"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculadora Científica" Height="600" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Display -->
        <TextBox x:Name="txtDisplay" FontSize="24" Height="50" IsReadOnly="True" VerticalAlignment="Top" />

        <!-- Botones -->
        <UniformGrid Grid.Row="1" Columns="5" Rows="7" Margin="0,10,0,10">
            <!-- Fila 1 -->
            <Button Content="sin" Click="Btn_Click"/>
            <Button Content="cos" Click="Btn_Click"/>
            <Button Content="tan" Click="Btn_Click"/>
            <Button Content="ln" Click="Btn_Click"/>
            <Button Content="log" Click="Btn_Click"/>

            <!-- Fila 2 -->
            <Button Content="(" Click="Btn_Click"/>
            <Button Content=")" Click="Btn_Click"/>
            <Button Content="π" Click="Btn_Click"/>
            <Button Content="e" Click="Btn_Click"/>
            <Button Content="^" Click="Btn_Click"/>

            <!-- Fila 3 -->
            <Button Content="7" Click="Btn_Click"/>
            <Button Content="8" Click="Btn_Click"/>
            <Button Content="9" Click="Btn_Click"/>
            <Button Content="/" Click="Btn_Click"/>
            <Button Content="√" Click="Btn_Click"/>

            <!-- Fila 4 -->
            <Button Content="4" Click="Btn_Click"/>
            <Button Content="5" Click="Btn_Click"/>
            <Button Content="6" Click="Btn_Click"/>
            <Button Content="*" Click="Btn_Click"/>
            <Button Content="!" Click="Btn_Click"/>

            <!-- Fila 5 -->
            <Button Content="1" Click="Btn_Click"/>
            <Button Content="2" Click="Btn_Click"/>
            <Button Content="3" Click="Btn_Click"/>
            <Button Content="-" Click="Btn_Click"/>
            <Button Content="Ans" Click="Btn_Click"/>

            <!-- Fila 6 -->
            <Button Content="0" Click="Btn_Click"/>
            <Button Content="." Click="Btn_Click"/>
            <Button Content="C" Click="BtnClear_Click"/>
            <Button Content="=" Click="BtnEqual_Click"/>
            <Button Content="+" Click="Btn_Click"/>

            <!-- Fila 7 -->
            <Button Content="⌫" Click="BtnBackspace_Click"/>
            <Button Content="Aceptar" Grid.ColumnSpan="4" Click="BtnAceptar_Click"/>
        </UniformGrid>
    </Grid>
</Window>
