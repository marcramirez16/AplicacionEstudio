<Window x:Class="Grafica.VentanasSecundarias.PasosOperacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PasosOperacion" Height="600" Width="800"
        Background="#f0f0f0">

    <Window.Resources>
        <DropShadowEffect x:Key="PasoShadow" Color="#888" BlurRadius="4" ShadowDepth="2" Opacity="0.3"/>
    </Window.Resources>

    <Grid Margin="15">
        <StackPanel>

            <TextBlock Text="Pasos de Operación" FontWeight="Bold" FontSize="20" Foreground="black" Margin="0,0,0,15"/>

            <ScrollViewer Height="450" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ListaPasos" ItemsSource="{Binding Pasos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="8" Margin="0,5,0,5" Padding="10"
                                    BorderBrush="#ddd" BorderThickness="1" Effect="{StaticResource PasoShadow}">
                                <StackPanel>

                                    <!-- Nombre del paso con resumen a la derecha -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,5">
                                        <Border Width="30" Height="30" Background="#3A5C4A" CornerRadius="15" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Numero}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </Border>

                                        <DockPanel Margin="10,0,0,0" LastChildFill="False">
                                            <TextBox Text="{Binding NombrePaso, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="400"
                                                     Padding="5"
                                                     FontSize="14"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MinHeight="30"
                                                     VerticalAlignment="Top"
                                                     DockPanel.Dock="Left"/>
                                            <TextBlock Text="Resumen operación"
                                                       Foreground="Gray"
                                                       VerticalAlignment="Center"
                                                       Margin="20,0,0,0"/>
                                            <Button Content="❌" Width="30" Height="30" Margin="5,0,0,0"
                                                    Click="EliminarPaso_Click" Tag="{Binding}"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <!-- Operaciones del paso -->
                                    <ItemsControl ItemsSource="{Binding Operaciones}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="40,2,0,2">
                                                    <TextBlock Text="Operación:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBox Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" 
                                                             Width="350"
                                                             Padding="5"
                                                             FontSize="14"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             MinHeight="30"
                                                             IsReadOnly="True"
                                                             PreviewMouseDown="OperacionTextBox_Click"/>
                                                    <Button Content="❌" Width="30" Height="30" Margin="5,0,0,0" 
                                                            Click="EliminarOperacion_Click" Tag="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="➕ Agregar Operación" Width="150" Height="30" Margin="40,5,0,0" HorizontalAlignment="Left"
                                            Click="AgregarOperacion_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Content="➕ Agregar Paso" Width="150" Height="35" Margin="0,15,0,0" HorizontalAlignment="Left"
                    Background="#3A5C4A" Foreground="White" BorderBrush="black" BorderThickness="0" FontWeight="Bold"
                    Cursor="Hand"
                    Click="AgregarPaso_Click"/>
        </StackPanel>
    </Grid>
</Window>
