     <Window x:Class="Grafica.VentanasSecundarias.VentanaPreguntasManual"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    mc:Ignorable="d"
        Title="Crear Pregunta Manualmente"
        Height="330" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="White">


    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Crear Preguntas Manualmente"
                       FontSize="13"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <!-- Lista de preguntas -->
            <ScrollViewer Height="200" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ListaPreguntas">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,5,0,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding Texto}" 
                                     Width="250" 
                                     AcceptsReturn="True" 
                                     TextWrapping="Wrap" 
                                     VerticalScrollBarVisibility="Auto" 
                                     MinHeight="30"
                                     TextChanged="TextBox_TextChanged"/>
                                    <Button Content="x" Width="25" Margin="5,0,0,0" 
                            Click="ToggleExpander_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <!-- Apariencia normal -->
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="Red"/>
                                                <Setter Property="BorderBrush" Value="Red"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="FontWeight" Value="Bold"/>

                                                <Style.Triggers>
                                                    <!-- Efecto al pasar el mouse -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="Red"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="Red"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="✓" Width="25" Margin="0,0,5,0"
                                    Click="GuardarPregunta_Click"
                                         >
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <!-- Estado normal -->
                                                <Setter Property="Background" Value="LightGreen"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="Green"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="IsEnabled" Value="False"/>

                                                <!-- Efecto al pasar el mouse -->
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="Green"/>
                                                    </Trigger>

                                                    <!-- Cuando esté deshabilitado -->
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="DarkGreen"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="Opacity" Value="0.8"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        
                                    </Button>
                                </StackPanel>

                                <Image Height="100"
                               Margin="30,5,0,5"
                               Stretch="Uniform"
                               Visibility="{Binding MostrarImagen}"
                               Source="{Binding ImagenPorDefecto}"
                               MouseLeftButtonUp="Imagen_Click"/>
                                
                                <!-- Panel de configuración oculto -->
                                <Expander x:Name="ExpanderConfig" Header="Opciones" IsExpanded="False" Margin="30,5,0,0">
                                    <StackPanel>
                                        <RadioButton Content="Matematicas 'calculadora'" Margin="0,5"
                                                         GroupName="{Binding grupo}" 
                                                    Checked="RadioButton_Changed"
                                                     Tag="mates"/>
                                        <RadioButton Content="Respuesta Texto Normal" Margin="0,5"
                                                         GroupName="{Binding grupo}" 
                                                    Checked="RadioButton_Changed"
                                                     Tag="normal"
                                                     IsChecked="True"/>

                                        <TextBox Text="{Binding Respuesta}" 
                                                 Width="230" 
                                                 AcceptsReturn="True" 
                                                 TextWrapping="Wrap" 
                                                 VerticalScrollBarVisibility="Auto" 
                                                 MinHeight="30"
                                                 Margin="0,2"
                                                 TextChanged="TextBoxRespuesta_TextChanged"
                                        />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Botón para agregar una nueva pregunta -->
            <Button Content="+" Width="50" Margin="0,5,0,10"
                    Click="AgregarPregunta_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <!-- Apariencia normal -->
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="DarkGreen"/>
                        <Setter Property="BorderBrush" Value="DarkGreen"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="FontWeight" Value="Bold"/>

                        <Style.Triggers>
                            <!-- Efecto al pasar el mouse -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="DarkGreen"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="DarkGreen"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>


        </StackPanel>
    </Grid>
</Window>



